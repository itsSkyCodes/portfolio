{
  "name": "shyam-kumar-yadav-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "check-node": "node -e \"if (Number(process.versions.node.split('.')[0]) < 20) { console.error('Node.js 20.9+ is required. Current: ' + process.version + '. Run: nvm use'); process.exit(1); }\"",
    "predev": "npm run check-node",
    "dev": "node scripts/run-next.mjs dev",
    "prebuild": "npm run check-node",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
