# Public site URL used for canonical, Open Graph, sitemap, and robots.
# Must be an absolute URL with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional local port override (defaults to 3000 or port in NEXT_PUBLIC_SITE_URL)
PORT=3000

# Brevo transactional email. Never expose these in client code.
# The sender address must be a verified sender in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Shyam Kumar Yadav
BREVO_RECIPIENT_EMAIL=shyamsky1914@gmail.com
